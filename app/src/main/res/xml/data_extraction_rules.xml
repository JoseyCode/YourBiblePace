<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same data is included for Google cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
